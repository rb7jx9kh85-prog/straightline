# === Clé serveur uniquement — jamais exposée au navigateur ===

# OBLIGATOIRE — ta clé OpenAI : https://platform.openai.com/api-keys
# (Vérifie que l'organisation de la clé a bien du crédit, sinon erreur « quota ».)
OPENAI_API_KEY=sk-...

# (Optionnel) Modèle. Défaut gpt-4o-mini (rapide & économique, < 0,8 s).
# Pour plus de finesse sur un gros rendez-vous : gpt-4o
COACH_MODEL=gpt-4o-mini

# (Optionnel) Endpoint compatible OpenAI (Azure, proxy…). Vide = OpenAI standard.
OPENAI_BASE_URL=
