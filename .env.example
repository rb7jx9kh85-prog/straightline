# === Clés serveur uniquement (jamais exposées au front) ===

# Clé API Anthropic (obligatoire pour le coach IA)
ANTHROPIC_API_KEY=sk-ant-...

# Modèle LLM. Par défaut : claude-haiku-4-5 (rapide, < 0,8 s — cf. cahier des charges).
# Pour un rendez-vous important où 0,3 s de plus est acceptable : claude-opus-4-8
COACH_MODEL=claude-haiku-4-5

# Clé Deepgram (optionnelle — uniquement pour le STT "propre" avec diarization).
# Sans elle, l'app fonctionne en Web Speech (navigateur) + mode simulation.
DEEPGRAM_API_KEY=
