# === Clés serveur uniquement (jamais exposées au front) ===

# Clé API OpenAI (obligatoire pour le coach IA). Format : sk-...
OPENAI_API_KEY=sk-...

# Modèle LLM OpenAI. Par défaut : gpt-4o-mini (rapide, < 0,8 s — cf. cahier des charges).
# Pour plus de finesse sur un rendez-vous important : gpt-4o
COACH_MODEL=gpt-4o-mini

# (Optionnel) Endpoint compatible OpenAI (Azure OpenAI, proxy, etc.).
# Laisser vide pour l'API OpenAI standard.
OPENAI_BASE_URL=

# Clé Deepgram (optionnelle — uniquement pour le STT "propre" avec diarization).
# Sans elle, l'app fonctionne en Web Speech (navigateur) + mode simulation.
DEEPGRAM_API_KEY=
